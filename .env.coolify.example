# Variables de entorno para Coolify (pestaña "Environment Variables" del recurso).
# Las marcadas con * son obligatorias; el resto tiene un valor por defecto.

# * Contraseña de la base de datos (inventa una larga; solo la usan db y api).
POSTGRES_PASSWORD=
# * Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# * El mismo dominio que le des al servicio `web` en Coolify, con https y SIN diagonal final.
FRONTEND_URL=https://go.tu-dominio.com

# * Correo (obligatorio: ahí llegan los enlaces de acceso y las alertas de mantenimiento).
MAIL_FROM=CHRISCO Go <no-responder@tu-dominio.com>
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Opcionales.
TIMEZONE=America/Mexico_City
SALES_WHATSAPP_NUMBER=
IVA_RATE=0.16
ANTICIPO_DEFAULT_PERCENT=30
COTIZACION_VALIDA_HORAS=24
MAX_ACTIVE_REQUESTS_PER_COMPANY=3
MANTENIMIENTO_AVISO_HORAS=50
MANTENIMIENTO_AVISO_DIAS=15
