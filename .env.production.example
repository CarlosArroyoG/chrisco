# Copia este archivo a .env.production y llena los valores. NUNCA lo subas a git.

# --- Docker Compose ---
DOMAIN=go.tu-dominio.com
POSTGRES_PASSWORD=
TIMEZONE=America/Mexico_City

# --- API ---
ENVIRONMENT=production
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FRONTEND_URL=https://go.tu-dominio.com
CORS_ORIGINS=["https://go.tu-dominio.com"]

# Correo (obligatorio smtp en producción: ahí llegan los enlaces y las alertas).
MAIL_BACKEND=smtp
MAIL_FROM=CHRISCO Go <no-responder@tu-dominio.com>
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# WhatsApp de ventas (solo dígitos con código de país, p. ej. 5217221234567).
SALES_WHATSAPP_NUMBER=

# Límite de intentos: con una sola instancia basta la memoria. Con varias: redis://redis:6379
RATE_LIMIT_STORAGE_URI=memory://

# Ajustes de negocio (valores por defecto).
IVA_RATE=0.16
ANTICIPO_DEFAULT_PERCENT=30
COTIZACION_VALIDA_HORAS=24
MAX_ACTIVE_REQUESTS_PER_COMPANY=3
MANTENIMIENTO_AVISO_HORAS=50
MANTENIMIENTO_AVISO_DIAS=15
